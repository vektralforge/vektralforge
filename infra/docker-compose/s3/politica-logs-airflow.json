{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogsDeTareasDeAirflow",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::airflow-logs",
        "arn:aws:s3:::airflow-logs/*"
      ]
    }
  ]
}

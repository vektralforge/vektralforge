# VektralForge — variables de entorno
#
#   cp .env.example infra/docker-compose/.env
#
# El destino NO es la raíz del repositorio: Docker Compose lee el .env del
# directorio donde está el docker-compose.yml. `make dev-up` lo verifica antes
# de levantar nada.
#
# Los valores de este archivo son de ejemplo y sirven únicamente para
# desarrollo local. Genera credenciales propias antes de exponer el stack en
# cualquier red que no sea la tuya: los puertos se publican en 0.0.0.0, así que
# en una red compartida cualquiera alcanza MinIO y Airflow.
#
# Las claves marcadas GENERAR deben crearse con los comandos indicados. No
# reutilices las de otro entorno ni dejes el placeholder.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Base de metadatos de Airflow, Hive Metastore, Marquez y Superset.
# El usuario y la contraseña se fijan al crear el volumen: cambiarlos después
# exige `make dev-reset`.
POSTGRES_USER=vektralforge
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_MULTIPLE_DATABASES=airflow,metastore,marquez,superset

# ── Airflow ───────────────────────────────────────────────────────────────────
# La cadena de conexión a Postgres NO se define aquí: la construye
# docker-compose.yml a partir de POSTGRES_USER y POSTGRES_PASSWORD. El .env no
# interpola sus propias variables, así que declararla aquí produce un usuario
# literal "POSTGRES_USER" y un fallo de autenticación difícil de rastrear.

AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Cifra las conexiones y variables guardadas en la base de metadatos. Perderla
# significa perder el acceso a todo lo cifrado con ella.
# GENERAR: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=GENERAR

# Firma las sesiones de la interfaz web.
# GENERAR: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API__SECRET_KEY=GENERAR

# Firma los JWT entre el scheduler y el api-server. En Airflow 3 las tareas no
# acceden a la base de metadatos: hablan con el api-server por HTTP. Si los
# contenedores no comparten esta clave, cada proceso genera la suya y las
# tareas fallan con 401.
# GENERAR: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=GENERAR

AIRFLOW_CONN_SPARK_DEFAULT=spark://spark-master:7077

# Usuario administrador, creado por `make dev-reset`.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar-esta-clave
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ── MinIO ─────────────────────────────────────────────────────────────────────
# Los nombres MINIO_ACCESS_KEY y MINIO_SECRET_KEY están deprecados desde 2021;
# las versiones recientes los ignoran.
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=vektralforge
MINIO_ROOT_PASSWORD=cambiar-esta-clave

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ── Linaje (OpenLineage / Marquez) ────────────────────────────────────────────
# Puerto interno de la red de Compose. Publicado en 9100 hacia el host, porque
# en macOS AirPlay ocupa el 5000 y MinIO el 9000.
OPENLINEAGE_URL=http://marquez-api:9000
OPENLINEAGE_NAMESPACE=vektralforge
MARQUEZ_LOG_LEVEL=INFO

# ── Trino ─────────────────────────────────────────────────────────────────────
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=trino

# ── Hive Metastore ────────────────────────────────────────────────────────────
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# ── Superset ──────────────────────────────────────────────────────────────────
# GENERAR: python3 -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=GENERAR
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=cambiar-esta-clave
SUPERSET_ADMIN_EMAIL=admin@example.com

REDIS_URL=redis://redis:6379/0

# ── OpenBao ───────────────────────────────────────────────────────────────────
# En local arranca en modo -dev: almacenamiento en memoria y sellado
# automático. No es una configuración de producción.
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=cambiar-este-token

# ── SQL Server (opcional) ─────────────────────────────────────────────────────
# Conector para ingerir desde una base SQL Server existente. Está desactivado:
# para habilitarlo, renombra trino/catalog/sqlserver.properties.disabled
# quitando el sufijo. Deja estas variables vacías si no lo usas.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

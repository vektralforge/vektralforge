# ─────────────────────────────────────────────────────────────────────────────
# .env.example — lakeforge
# Copia este archivo a infra/docker-compose/.env y completa los valores reales.
#
#   cp .env.example infra/docker-compose/.env
#
# ⚠ NUNCA commitear el archivo .env a Git.
#   .env está en .gitignore. Este archivo (.env.example) SÍ se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=lakeforge
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_MULTIPLE_DATABASES=airflow,metastore,marquez

# ── Usuarios admin (leídos por make dev-reset) ────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CAMBIAR_EN_PRODUCCION
AIRFLOW_ADMIN_EMAIL=admin@alephserver.cl
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CAMBIAR_EN_PRODUCCION
SUPERSET_ADMIN_EMAIL=admin@alephserver.cl

# ── Apache Airflow ────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/airflow  # pragma: allowlist secret
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CAMBIAR_POR_CLAVE_GENERADA
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA
AIRFLOW_CONN_SPARK_DEFAULT=spark://spark-master:7077

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CAMBIAR_EN_PRODUCCION
MINIO_SECRET_KEY=CAMBIAR_EN_PRODUCCION

# ── Apache Spark ──────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ── OpenBao (Gestión de credenciales y secretos) ──────────────────────────────
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=CAMBIAR_EN_PRODUCCION

# ── OpenLineage / Marquez ─────────────────────────────────────────────────────
# Backend de linaje — recibe eventos automáticos desde Airflow y Spark
OPENLINEAGE_URL=http://marquez-api:5000
OPENLINEAGE_NAMESPACE=lakeforge
# UI de linaje: http://localhost:3000
# API admin:    http://localhost:5001/healthcheck

# ── SQL Server (fuente de datos del cliente) ──────────────────────────────────
SQLSERVER_HOST=CAMBIAR_POR_HOST_REAL
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=CAMBIAR_POR_BASE_DE_DATOS
SQLSERVER_USER=CAMBIAR_POR_USUARIO
SQLSERVER_PASSWORD=CAMBIAR_POR_PASSWORD

# ── Apache Superset ───────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Trino ─────────────────────────────────────────────────────────────────────
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=trino

# ── Hive Metastore ────────────────────────────────────────────────────────────
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# ─────────────────────────────────────────────────────────────────────────────
# NOTAS DE SEGURIDAD
# ─────────────────────────────────────────────────────────────────────────────
# 1. Staging:    Sealed Secrets (cifrado en Git, descifrado por K3s)
#    Produccion: OpenBao (rotacion automatica + auditoria completa)
# 2. Nunca poner contraseñas reales en este archivo.
# 3. detect-secrets bloquea commits con secretos reales via pre-commit hook.
# 4. Si cambias POSTGRES_USER o POSTGRES_PASSWORD, actualiza también
#    AIRFLOW__DATABASE__SQL_ALCHEMY_CONN con los nuevos valores.
# ─────────────────────────────────────────────────────────────────────────────

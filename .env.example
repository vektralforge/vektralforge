# ─────────────────────────────────────────────────────────────────────────────
# .env.example — lakeforge
# Copia este archivo a .env y completa los valores reales.
#
#   cp .env.example .env
#
# ⚠ NUNCA commitear el archivo .env a Git.
#   .env está en .gitignore. Este archivo (.env.example) SÍ se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apache Airflow ────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://lakeforge:lakeforge@postgres:5432/airflow  # pragma: allowlist secret
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CAMBIAR_POR_CLAVE_GENERADA
AIRFLOW__WEBSERVER__SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA
AIRFLOW_CONN_SPARK_DEFAULT=spark://spark-master:7077

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CAMBIAR_EN_PRODUCCION
MINIO_SECRET_KEY=CAMBIAR_EN_PRODUCCION
# MINIO_ACCESS_KEY=minioadmin  # pragma: allowlist secret
# MINIO_SECRET_KEY=minioadmin  # pragma: allowlist secret

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=lakeforge
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_MULTIPLE_DATABASES=airflow,metastore

# ── Apache Spark ──────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ── OpenBao (Gestión de credenciales y secretos) ──────────────────────────────
# Fork open source de HashiCorp Vault — MPL 2.0 / Linux Foundation
# API 100% compatible con Vault. Cliente Python: hvac
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=CAMBIAR_EN_PRODUCCION
# OPENBAO_TOKEN=dev-root-token  # pragma: allowlist secret

# ── SQL Server (fuente de datos) ──────────────────────────────────────────────
# En producción estas credenciales se leen desde OpenBao, no desde .env.
SQLSERVER_HOST=CAMBIAR_POR_HOST_REAL
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=CAMBIAR_POR_BASE_DE_DATOS
SQLSERVER_USER=CAMBIAR_POR_USUARIO
SQLSERVER_PASSWORD=CAMBIAR_POR_PASSWORD

# ── Apache Superset ───────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA
SUPERSET_DATABASE_URL=postgresql+psycopg2://lakeforge:lakeforge@postgres:5432/airflow  # pragma: allowlist secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Trino ─────────────────────────────────────────────────────────────────────
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=trino

# ── Hive Metastore ────────────────────────────────────────────────────────────
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# ─────────────────────────────────────────────────────────────────────────────
# NOTAS DE SEGURIDAD
# ─────────────────────────────────────────────────────────────────────────────
# 1. Staging:    Sealed Secrets (cifrado en Git, descifrado por K3s)
#    Produccion: OpenBao (rotacion automatica + auditoria completa)
#
# 2. Nunca poner contraseñas reales en este archivo.
#    .env.example se versiona en Git. .env NO se versiona.
#
# 3. detect-secrets bloquea commits con secretos reales via pre-commit hook.
#
# 4. Leer secretos desde OpenBao en Python:
#    import hvac, os
#    client = hvac.Client(url=os.getenv("OPENBAO_ADDR"), token=os.getenv("OPENBAO_TOKEN"))
#    secret = client.secrets.kv.v2.read_secret_version(path="sqlserver/credentials")
#    password = secret["data"]["data"]["password"]
# ─────────────────────────────────────────────────────────────────────────────

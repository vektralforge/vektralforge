# Trino — conector SQL Server (consultas federadas)
# Credenciales inyectadas desde OpenBao en runtime.
connector.name=sqlserver
connection-url=jdbc:sqlserver://${ENV:SQLSERVER_HOST}:${ENV:SQLSERVER_PORT};databaseName=${ENV:SQLSERVER_DATABASE}
connection-user=${ENV:SQLSERVER_USER}
connection-password=${ENV:SQLSERVER_PASSWORD}
